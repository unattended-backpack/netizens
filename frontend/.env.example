# ─────────────────────────────────────────────────────────────────────────────
# Netizens bridge — frontend configuration (PRODUCTION template)
#
# Copy to `.env.local` (gitignored) and fill in the blanks, or set these VITE_*
# vars in your host/CI environment. Anything left unset falls back to the verified
# mainnet defaults baked into src/constants/bridge.ts, so the minimum to go live is
# the deploy-specific block near the bottom (NetizenL1, NetizenBridgeL2, blocks).
#
# NOTE: the localnet harness writes its OWN `.env.local` automatically (see
# ../localnet.sh) with the anvil fork values — do not point it at these mainnet
# settings.
# ─────────────────────────────────────────────────────────────────────────────

# ── RPC endpoints (set your own — public endpoints rate-limit hard) ───────────
VITE_L1_RPC_URL=https://eth.llamarpc.com
VITE_L2_RPC_URL=https://mainnet.megaeth.com/rpc

# ── Block-explorer bases for the header's contract links (no trailing slash) ──
# L1 defaults to Etherscan. Set VITE_L2_EXPLORER to the L2 explorer; each link
# renders only once its explorer base is set and the contract address is known.
VITE_L1_EXPLORER=https://etherscan.io
VITE_L2_EXPLORER=https://mega.etherscan.io

# ── Ethereum L1: OP-Stack infra (verified MegaETH mainnet values) ─────────────
VITE_OPTIMISM_PORTAL_ADDRESS=0x7f82f57F0Dd546519324392e408b01fcC7D709e8
VITE_L1_CROSS_DOMAIN_MESSENGER=0x6C7198250087B29A8040eC63903Bc130f4831Cc9
VITE_DISPUTE_GAME_FACTORY=0x8546840adF796875cD9AAcc5B3B048f6B2c9D563
VITE_L1_STANDARD_BRIDGE=0x0CA3A2FBC3D770b578223FBB6b062fa875a2eE75
VITE_KAILUA_GAME_TYPE=1337
# Leave unset for Ethereum mainnet (chainId 1). The localnet sets a dev chainId.
# VITE_L1_CHAIN_ID=1

# ── MegaETH L2 ────────────────────────────────────────────────────────────────
VITE_L2_CHAIN_ID=4326
VITE_NFT_CONTRACT_ADDRESS=0x3fD43a658915A7Ce5ae0A2E48f72B9fCE7bA0C44
# Real MegaETH serves eth_getWithdrawalProof — keep this FALSE/unset in production.
# (The anvil localnet sets it true because the fork speaks standard eth_getProof.)
# VITE_L2_USE_GETPROOF=false

# ── Deploy-specific — FILL THESE IN after deploying the contracts ─────────────
# NetizenL1 (Ethereum) + NetizenBridgeL2 (MegaETH); see contracts/script.
VITE_NETIZEN_L1=
VITE_BRIDGE_L2=
# Block each contract was deployed at — the lower bound for mint / Transfer log
# scans. 0 works but scans the whole chain (slow); set the real deploy block.
VITE_NETIZEN_L1_DEPLOY_BLOCK=
VITE_WCN_DEPLOY_BLOCK=7852660

# ── Optional ──────────────────────────────────────────────────────────────────
# Tokens per force-inclusion deposit (default 48; ~55 is the 1M-L2-gas ceiling).
# VITE_BRIDGE_BATCH_SIZE=48

# ── Localnet-only — DO NOT set in production ──────────────────────────────────
# Written automatically by ../localnet.sh; shown here only for reference.
# VITE_IS_LOCALNET=true            # enables the fast-forward button + relayer tx lookup
# VITE_RELAYER_CONTROL=http://127.0.0.1:8547
