# Dependencies (reinstall with npm install)
node_modules/

# Soldeer-managed Solidity deps (restore with `forge soldeer install`; pinned by soldeer.lock)
contracts/dependencies/

# Build / project output
dist/
frontend/dist/

# Foundry output
contracts/out/
contracts/cache/
contracts/broadcast/

# Local env — committed: .env.example, .env.maintainer (public defaults)
# ignored: .env and anything *.local (hold secrets)
.env
.env.local
.env*.local

# Localnet runtime artifacts (regenerated by scripts/localnet.sh on every `up`)
*.log
.localnet.pids
deployments.local.json

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/
